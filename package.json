{
  "name": "pulseboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @pulseboard/api\" \"npm run dev -w @pulseboard/web\"",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run migrate -w @pulseboard/api",
    "build": "npm run build -w @pulseboard/api && npm run build -w @pulseboard/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "test": "npm run test -w @pulseboard/api",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
