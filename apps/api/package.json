{
  "name": "@pulseboard/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "openid-client": "^6.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.18",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
