# Copy to .env for local development. These values are for your machine only.

# PostgreSQL in Docker. 5433 avoids clashing with a local PostgreSQL install.
POSTGRES_PASSWORD=pulseboard_owner_dev
POSTGRES_PORT=5433

# Password of the restricted role the API connects as.
APP_DB_PASSWORD=pulseboard_app_dev

# Owner connection, used only to run migrations.
MIGRATION_DATABASE_URL=postgres://pulseboard:pulseboard_owner_dev@127.0.0.1:5433/pulseboard
# API connection, subject to row-level security.
DATABASE_URL=postgres://pulseboard_app:pulseboard_app_dev@127.0.0.1:5433/pulseboard

# Where the web app is opened in the browser.
APP_URL=http://localhost:3000

# Optional single sign-on (any OpenID Connect provider, for example Google).
# Redirect URI to register: <APP_URL>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Optional: run the tests against an existing server (superuser connection)
# instead of starting one with Testcontainers.
# TEST_DATABASE_URL=postgres://pulseboard:pulseboard_owner_dev@127.0.0.1:5433/postgres
