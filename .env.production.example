# Copy to .env.production on the server. See docs/deployment.md.

# Domain whose DNS record points at the server.
DOMAIN=pulseboard.example.com

# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Optional single sign-on.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
